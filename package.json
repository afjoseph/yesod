{
  "name": "yesod",
  "version": "2.0.0",
  "description": "Lispy Command Runner",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/grammar.pegjs dist/",
    "prepare": "npm run build",
    "check": "tsc --noEmit && eslint src test",
    "test": "node --test test/*.ts"
  },
  "dependencies": {
    "@types/humanize-duration": "^3.27.4",
    "humanize-duration": "^3.32.1",
    "peggy": "^4.2.0",
    "winston": "^3.17.0",
    "zx": "8.8.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^10.8.0",
    "expect": "30.4.1",
    "jiti": "^2.6.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
